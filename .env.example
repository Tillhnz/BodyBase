# Kopiere diese Datei nach .env und passe die Werte an (install.sh erledigt das automatisch).

# Beliebiges, langes Passwort für die Datenbank
POSTGRES_PASSWORD=bitte-aendern

# Zufälliger Schlüssel für Anmeldungen und zum Verschlüsseln der Anbieter-Zugänge: openssl rand -hex 32
# Nicht mehr ändern, sonst müssen alle Quellen neu verbunden werden.
SECRET_KEY=bitte-aendern

# Öffentliche Adresse. Die Anbieter (Strava, Withings, Fitbit …) leiten nach der Anmeldung hierher zurück.
PUBLIC_URL=http://localhost:8080

# false = nur das erste Konto und Eingeladene dürfen sich registrieren
ALLOW_REGISTRATION=false

# Proxys vor BodyBase (Nginx Proxy Manager = 1), wichtig für die Login-Drosselung
TRUSTED_PROXIES=0

# Wie lange eine Anmeldung gilt (Tage)
TOKEN_EXPIRE_DAYS=30

# Port im Heimnetz (Ziel für den Nginx Proxy Manager)
WEB_PORT=8080

TIMEZONE=Europe/Berlin

# Abgleich mit den Anbietern: alle wie viele Minuten, und wie weit zurück beim ersten Verbinden
SYNC_INTERVAL_MINUTES=60
BACKFILL_DAYS=90

# Einbetten erlauben (z. B. in Home Assistant): Adressen mit Leerzeichen getrennt. Dann COOKIE_SAMESITE=lax.
FRAME_ANCESTORS=
COOKIE_SAMESITE=strict

# Sicherungen: Ordner (z. B. NFS) und öffentlicher age-Schlüssel zum Verschlüsseln.
# Einrichten mit: bodybase backup-dir /pfad   und   bodybase backup-key
BACKUP_DIR=./backups
BACKUP_AGE_RECIPIENT=

# Karten: Standard ist OpenStreetMap. Für die dunkle CARTO-Karte einen kostenlosen Schlüssel eintragen
# (https://carto.com/basemaps/apikey/) oder eine eigene Kachel-URL mit {z}/{x}/{y}. Auch unter Administration → Server.
MAP_TILE_URL=
CARTO_API_KEY=
